# 이 파일을 .env 로 복사한 뒤 각자의 키를 채워 넣으세요.
#   cp .env.example .env
#
# Vite는 VITE_ 로 시작하는 변수만 코드에서 읽을 수 있습니다.

# OpenWeather API 키 — https://openweathermap.org/api 에서 발급
VITE_OWM_KEY=your_openweather_api_key

# 에어코리아 대기오염정보 서비스키 (디코딩된 값) — https://www.data.go.kr 에서 발급
VITE_AIR_KEY=your_airkorea_service_key
